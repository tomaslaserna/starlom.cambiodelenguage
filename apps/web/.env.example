SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
# Production should use the runtime role created by
# migrations/20260709135632_create_app_runtime_role.sql.
# If the pooler requires a qualified user, use starlim_app.<project-ref>.
SUPABASE_DB_USER=
SUPABASE_DB_PASS=
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=true

# Optional alternative. If set, DATABASE_URL has priority over the individual
# SUPABASE_DB_* variables above.
DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public application URL used in password recovery links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only key for Supabase Storage uploads. Never expose this with NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STARLIM_STORAGE_BUCKET=uploads

# Extra allowed origins for mutating requests, comma-separated, without wildcards.
STARLIM_ALLOWED_ORIGINS=

# Used to sign the new Node/React session cookie. Generate a long random value
# before deploying outside local development.
STARLIM_SESSION_SECRET=

# Must match the PHP app pepper while legacy usuarios.contrasena hashes are used.
STARLIM_PEPPER=

# Supervisor IA experimental. Server-only: no usar NEXT_PUBLIC_*.
# El modelo por defecto verificado es google/gemini-3.5-flash.
# Required locally. Vercel deployments can authenticate AI Gateway through OIDC.
AI_GATEWAY_API_KEY=
SUPERVISOR_AI_MODEL=google/gemini-3.5-flash
SUPERVISOR_AI_ENABLED=false
SUPERVISOR_TASKS_ENABLED=false

# Facturacion fiscal ARCA/AFIP. Estos valores son server-only: no usar NEXT_PUBLIC_*.
STARLIM_FISCAL_PROVIDER=disabled
STARLIM_FISCAL_MODE=testing
STARLIM_ARCA_CUIT=
STARLIM_ARCA_POINT_OF_SALE=1

# Local development can use file paths. Vercel should use *_BASE64 or *_PEM
# because local certificate paths do not exist inside serverless functions.
STARLIM_ARCA_CERT_PATH=
STARLIM_ARCA_KEY_PATH=
STARLIM_ARCA_CERT_BASE64=
STARLIM_ARCA_KEY_BASE64=
STARLIM_ARCA_CERT_PEM=
STARLIM_ARCA_KEY_PEM=
