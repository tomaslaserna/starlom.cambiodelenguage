# Supabase PostgreSQL — copiá estos valores de:
# Supabase Dashboard → Connect → Transaction pooler
# (el pooler es obligatorio en Vercel: el host directo db.*.supabase.co es solo IPv6)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
# Produccion debe usar el rol runtime creado por la migracion
# 20260709135632_create_app_runtime_role.sql.
# Si el pooler requiere usuario calificado, usar starlim_app.<project-ref>.
SUPABASE_DB_USER=
SUPABASE_DB_PASS=
# Validar certificado TLS del pooler Postgres. Dejar true/vacio en produccion.
# Usar false solo para diagnostico local controlado si una CA corporativa rompe TLS.
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=true

# Para Vercel: copiá estas variables en Project Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Storage (subida de imágenes/comprobantes — REQUERIDO en Vercel,
# el disco serverless es efímero). Service role key: Dashboard → Settings → API.
# Además crear el bucket público "uploads" en Dashboard → Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STARLIM_STORAGE_BUCKET=uploads

# Origenes extra permitidos para POST/PATCH/DELETE si hay dominios alternativos.
# Separar por coma. No incluir comodines.
STARLIM_ALLOWED_ORIGINS=

# Pepper de contraseñas (opcional; si no se setea usa el valor histórico.
# NO cambiarlo en un sistema con usuarios: rompe todos los hashes existentes)
STARLIM_PEPPER=

# Facturación ARCA/AFIP (por defecto: homologación con certificados de prueba)
STARLIM_FISCAL_PROVIDER=disabled
STARLIM_FISCAL_MODE=testing
STARLIM_ARCA_CUIT=
STARLIM_ARCA_POINT_OF_SALE=1

# Desarrollo local puede usar paths. Vercel debe usar *_BASE64 o *_PEM
# porque los paths locales no existen dentro de funciones serverless.
STARLIM_ARCA_CERT_PATH=
STARLIM_ARCA_KEY_PATH=
STARLIM_ARCA_CERT_BASE64=
STARLIM_ARCA_KEY_BASE64=
STARLIM_ARCA_CERT_PEM=
STARLIM_ARCA_KEY_PEM=
